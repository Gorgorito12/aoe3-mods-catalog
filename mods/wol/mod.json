{
  "$schema": "https://raw.githubusercontent.com/Gorgorito12/aoe3-mods-catalog/main/schema/mod.schema.json",
  "id": "wol",
  "displayName": "Wars of Liberty",
  "subtitle": "Launcher",
  "accentColor": "#c8102e",
